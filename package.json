{
  "name": "saucedemo-cypress-automation",
  "version": "1.0.0",
  "description": "Cypress E2E test automation for SauceDemo: sign-in (standard & locked-out users) and product page.",
  "author": "Sharon Ogboli",
  "license": "MIT",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:login": "cypress run --spec cypress/e2e/login.cy.js",
    "test:products": "cypress run --spec cypress/e2e/products.cy.js"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "cypress-mochawesome-reporter": "^5.0.0"
  }
}
